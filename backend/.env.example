PORT=5001
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Local development may use memory. Vercel production fails closed unless this
# points at shared Redis/Upstash or ALLOW_IN_MEMORY_RATE_LIMITS=true explicitly
# acknowledges that equivalent edge/WAF limits are configured.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=rediss://default:password@host:port/0
# ALLOW_IN_MEMORY_RATE_LIMITS=false
# Set to false to disable rate limiting entirely (e.g. in tests).
RATELIMIT_ENABLED=true
MAX_REQUEST_BYTES=16777216
MAX_ZIP_BYTES=262144000
MAX_ZIP_UPLOAD_BYTES=262144000
# Per-channel pixel ceiling for composite preview rendering (bounds peak memory).
MAX_RENDER_PIXELS=16000000
BLOB_UPLOAD_TOKEN_RATE_LIMIT=6
# Optional: force Vercel Blob upload callbacks to a known deployment origin.
# BLOB_UPLOAD_CALLBACK_ORIGIN=https://your-production-domain.example

# Local development writes temporary blot files here. If omitted, the OS temp
# directory is used.
BLOT_TEMP_STORAGE=local
BLOT_TEMP_DIR=/tmp/western-blot-browser-only

# Vercel production should use Blob-backed temporary storage instead.
# BLOT_TEMP_STORAGE=vercel-blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Temporary blot files are PRIVATE by default. BLOB_ACCESS=public makes them
# world-readable by URL and is ignored unless BLOB_PUBLIC_ACCESS_ACK=true is
# also set as an explicit acknowledgment.
# BLOB_ACCESS=public
# BLOB_PUBLIC_ACCESS_ACK=true

# Vercel Cron sends this value as Authorization: Bearer <value> to the daily
# orphan cleanup endpoint. Use a random value of at least 16 characters.
# CRON_SECRET=replace-with-a-long-random-secret
# Vercel uses the scheduled cleanup; local mode sweeps during uploads.
TEMP_SWEEP_ON_UPLOAD=true

# The sweep covers both temp roots. Per-blot files under sessions/ use
# TEMP_FILE_TTL_SECONDS (24h): a tab may come back to them. Directly uploaded ZIPs
# under uploads/ are consumed inside one /process-upload call, so anything older
# than this is abandoned by definition — a browser that PUTs its ZIP and then never
# calls /process-upload leaves nothing else to delete it.
# TEMP_FILE_TTL_SECONDS=86400
# UPLOAD_FILE_TTL_SECONDS=3600

# Descriptor URLs are host-checked against *.blob.vercel-storage.com, which does not
# pin the STORE — so a request can name a store this deployment does not own.
#   log     (default) report a mismatch and allow it
#   enforce reject it
#   off     no check
# Ships as "log" so you can confirm zero blob_host_pin_mismatch events across a full
# traffic cycle (every legitimate descriptor is one your own store minted, so the
# expected count is zero) before switching to enforce.
# BLOB_HOST_PIN=enforce
